---
import Base from '../../../layouts/Base.astro';
import { wings } from '../../../data/museum';

export function getStaticPaths() {
  return wings.flatMap((wing) =>
    wing.rooms.map((room) => ({ params: { wing: wing.slug, room: room.slug }, props: { wing, room } })),
  );
}
const { wing, room } = Astro.props;
---

<Base title={`${room.title} — Museum`}>
  <p class="crumbs"><a href="/">Wings</a> / <a href={`/${wing.slug}/`}>{wing.title}</a> / {room.title}</p>
  <h1>{room.title}</h1>
  <p>{room.description}</p>
  <ul class="cards">
    {
      room.items.map((i) => (
        <li>
          <a href={`/${wing.slug}/${room.slug}/${i.slug}/`}>{i.title}</a> <small>{i.year}</small>
          <div>{i.summary}</div>
        </li>
      ))
    }
  </ul>
</Base>
