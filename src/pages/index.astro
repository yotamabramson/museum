---
import Base from '../layouts/Base.astro';
import { wings } from '../data/museum';
---

<Base title="Museum of Things I Made">
  <p><a href="/walk/">Walk through the museum in 3D →</a></p>
  <h1>Wings</h1>
  {wings.length === 0 && <p>The museum is empty. Run <code>npm run admin</code> to add exhibits.</p>}
  <ul class="cards">
    {
      wings.map((w) => (
        <li>
          <a href={`/${w.slug}/`}>{w.title}</a> <small>{w.rooms.length} rooms</small>
          <div>{w.description}</div>
        </li>
      ))
    }
  </ul>
</Base>
