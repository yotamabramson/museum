{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Edit museum",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "admin"],
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "Museum admin: (https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "name": "View baked museum",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "view"],
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "(https?://localhost:\\d+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ]
}
