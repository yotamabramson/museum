---
import Base from '../../../layouts/Base.astro';
import ItemCard from '../../../components/ItemCard.astro';
import { wings } from '../../../data/museum';

export function getStaticPaths() {
  return wings.flatMap((wing) =>
    wing.rooms.map((room) => ({ params: { wing: wing.slug, room: room.slug }, props: { wing, room } })),
  );
}
const { wing, room } = Astro.props;
---

<Base title={`${room.title} — Museum`} description={room.description || undefined}>
  <nav class="crumbs">
    <a href="/">Museum</a><i>/</i><a href={`/${wing.slug}/`}>{wing.title}</a><i>/</i><span>{room.title}</span>
  </nav>
  <div class="intro">
    <div class="eyebrow">{wing.title}</div>
    <h1>{room.title}</h1>
    {room.description && <p>{room.description}</p>}
  </div>
  {room.items.length === 0 && <p class="empty">No items in this room yet.</p>}
  <div class="items">
    {room.items.map((item) => <ItemCard href={`/${wing.slug}/${room.slug}/${item.slug}/`} item={item} />)}
  </div>
</Base>
